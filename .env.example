# ZenControl TPI MCP Server — environment configuration
# Copy to .env and fill in values.

# Required: IP address or hostname of the ZenControl controller
ZENCONTROL_TPI_HOST=192.168.1.100

# Optional: TPI TCP port (default: 5108)
# ZENCONTROL_TPI_PORT=5108

# Optional: Lock the MCP server to a specific DALI group (0-15)
# When set, tools will reject commands targeting other groups.
# ZENCONTROL_SCOPE_GROUP=0
